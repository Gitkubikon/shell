if has nix; then
    use flake
fi

# Nix devShell leaks Qt 6.10.2 paths that conflict with system Qt 6.11.0 at runtime.
# Ensure system binaries (qs, clang++) take precedence and nix Qt vars don't pollute runtime.
PATH="/usr/bin:$PATH"
unset QT_ADDITIONAL_PACKAGES_PREFIX_PATH QMAKEPATH QMAKEMODULES QMAKE

shopt -s globstar
watch_file assets/cpp/**/*.cpp
watch_file assets/cpp/**/*.hpp
watch_file plugin/**/*.cpp
watch_file plugin/**/*.hpp
watch_file **/CMakeLists.txt

cmake -B build -G Ninja -DCMAKE_BUILD_TYPE=RelWithDebInfo -DCMAKE_CXX_COMPILER=/usr/bin/clang++ -DCMAKE_EXPORT_COMPILE_COMMANDS=ON -DDISTRIBUTOR=direnv
cmake --build build
export CAELESTIA_LIB_DIR="$PWD/build/lib"
export QML2_IMPORT_PATH="$PWD/build/qml"
